{
 "annotations": {
  "list": []
 },
 "editable": true,
 "fiscalYearStartMonth": 0,
 "graphTooltip": 1,
 "links": [
  {
   "type": "dashboards",
   "title": "Monitoring",
   "tags": [
    "monitoring"
   ],
   "asDropdown": false,
   "includeVars": false,
   "keepTime": true,
   "icon": "external link"
  }
 ],
 "refresh": "1m",
 "schemaVersion": 39,
 "tags": [
  "monitoring",
  "node"
 ],
 "panels": [
  {
   "type": "timeseries",
   "title": "CPU by mode",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[$__rate_interval])) / on() group_left() count(count by (cpu) (node_cpu_seconds_total)) * 100",
     "legendFormat": "{{mode}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "custom": {
      "fillOpacity": 30,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Load average",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_load1",
     "legendFormat": "1m"
    },
    {
     "refId": "B",
     "expr": "node_load5",
     "legendFormat": "5m"
    },
    {
     "refId": "C",
     "expr": "node_load15",
     "legendFormat": "15m"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 0,
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Memory",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "used"
    },
    {
     "refId": "B",
     "expr": "node_memory_Cached_bytes + node_memory_Buffers_bytes",
     "legendFormat": "cache"
    },
    {
     "refId": "C",
     "expr": "node_memory_MemAvailable_bytes",
     "legendFormat": "available"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "fillOpacity": 20,
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "bargauge",
   "title": "Filesystem use",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "100 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|overlay\"} * 100)",
     "legendFormat": "{{mountpoint}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 85
       },
       {
        "color": "red",
        "value": 93
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showUnfilled": true
   }
  },
  {
   "type": "timeseries",
   "title": "Disk throughput",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_disk_read_bytes_total[$__rate_interval])",
     "legendFormat": "read {{device}}"
    },
    {
     "refId": "B",
     "expr": "rate(node_disk_written_bytes_total[$__rate_interval])",
     "legendFormat": "write {{device}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Network",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[$__rate_interval])",
     "legendFormat": "in {{device}}"
    },
    {
     "refId": "B",
     "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[$__rate_interval])",
     "legendFormat": "out {{device}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "Bps",
     "custom": {
      "fillOpacity": 10,
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "stat",
   "title": "Days until / is full",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_filesystem_avail_bytes{mountpoint=\"/\"} / -deriv(node_filesystem_avail_bytes{mountpoint=\"/\"}[6h]) / 86400",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "d",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 14
       },
       {
        "color": "green",
        "value": 60
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "stat",
   "title": "Uptime",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 5,
    "w": 6,
    "x": 6,
    "y": 24
   },
   "targets": [
    {
     "refId": "A",
     "expr": "time() - node_boot_time_seconds",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "auto",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    }
   }
  },
  {
   "type": "table",
   "title": "Failed units",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 5,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "targets": [
    {
     "refId": "A",
     "expr": "node_systemd_unit_state{state=\"failed\"} == 1",
     "legendFormat": "",
     "instant": true,
     "range": false,
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "state": true,
       "type": true
      },
      "renameByName": {
       "name": "Unit"
      }
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Journal errors by unit",
   "datasource": "Loki",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 29
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (unit) (rate({job=\"systemd-journal\"} |~ \"(?i)(error|fatal|critical|failed)\" [$__auto]))",
     "legendFormat": "{{unit}}",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 20,
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Log volume by unit",
   "datasource": "Loki",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 29
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, sum by (unit) (rate({job=\"systemd-journal\"} [$__auto])))",
     "legendFormat": "{{unit}}",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "fillOpacity": 20,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  }
 ],
 "templating": {
  "list": []
 },
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "timezone": "browser",
 "title": "Host",
 "uid": "host-overview"
}