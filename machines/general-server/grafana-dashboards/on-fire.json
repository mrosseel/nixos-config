  {
   "type": "timeseries",
   "title": "Probe response time",
   "datasource": "Prometheus",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 30
   },
   "targets": [
    {
     "refId": "A",
     "expr": "probe_duration_seconds",
     "legendFormat": "{{instance}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 0,
      "showPoints": "never"
     }
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "5xx per host",
   "datasource": "Loki",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 30
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (request_host) (rate({job=\"caddy\", status=~\"5..\"} |= \"http.log.access\" [$__auto]))",
     "legendFormat": "{{request_host}}",
     "queryType": "range"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "fillOpacity": 30,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   }
